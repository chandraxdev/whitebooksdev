{
  "openapi": "3.1.0",
  "info": {
    "title": "WhiteBooks e-Way Bill: Generate Consolidated Ewaybill",
    "version": "2026-10-13",
    "description": "Operations of the WhiteBooks e-Way Bill API in the group Generate Consolidated Ewaybill, as of 2026-10-13. Start on the sandbox; every call needs your own WhiteBooks credentials and a session as the sign-in sequence describes."
  },
  "servers": [
    {
      "url": "https://apisandbox.whitebooks.in",
      "description": "Sandbox"
    },
    {
      "url": "https://api.whitebooks.in",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Generate Consolidated Ewaybill"
    }
  ],
  "paths": {
    "/ewaybillapi/v1.03/ewayapi/gencewb": {
      "post": {
        "operationId": "ewaybill-ewaybillapi-v1-03-ewayapi-gencewb-post",
        "summary": "Generate Consolidated Ewaybill",
        "tags": [
          "Generate Consolidated Ewaybill"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "Email registered with WhiteBooks",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_address",
            "in": "header",
            "required": true,
            "description": "Caller's public IP",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "client_id",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "client_secret",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "username",
            "in": "header",
            "required": true,
            "description": "NIC e-Invoice / EWB API user",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "gstin",
            "in": "header",
            "required": true,
            "description": "Taxpayer GSTIN (15 characters)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "fromPlace",
                  "fromState",
                  "transMode",
                  "tripSheetEwbBills"
                ],
                "type": "object",
                "properties": {
                  "fromPlace": {
                    "maxLength": 50,
                    "type": "string",
                    "description": "From Place"
                  },
                  "fromState": {
                    "type": "number",
                    "description": "From State"
                  },
                  "vehicleNo": {
                    "type": "string",
                    "description": "Vehicle Number"
                  },
                  "transMode": {
                    "type": "string",
                    "description": "Transport Mode (Road-1,Rail-2,Air-3,Ship-4)",
                    "enum": [
                      "1",
                      "2",
                      "3",
                      "4"
                    ]
                  },
                  "transDocNo": {
                    "maxLength": 15,
                    "type": "string",
                    "description": "Transport Document Number "
                  },
                  "transDocDate": {
                    "pattern": "[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]",
                    "type": "string",
                    "description": "Transport Document Date "
                  },
                  "tripSheetEwbBills": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ewbNo": {
                          "type": "number",
                          "description": "Ewaybill Number"
                        }
                      },
                      "required": [
                        "ewbNo"
                      ]
                    }
                  }
                }
              },
              "example": {
                "fromPlace": "FRAZER TOWN",
                "fromState": 5,
                "vehicleNo": "ABC1234",
                "transMode": "1",
                "transDocNo": "12",
                "transDocDate": "20/02/2024",
                "tripSheetEwbBills": [
                  {
                    "ewbNo": 381009282489
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reply. A failure can still come back as HTTP 200: check the error shapes in the WhiteBooks error reference."
          },
          "default": {
            "description": "A failure; the body carries the error code and message."
          }
        },
        "x-whitebooks-side-effect": "irreversible",
        "x-whitebooks-auth-flow": "ewb_session"
      }
    }
  }
}
