              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "client_secret",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "frmtyp": {
                    "type": "string",
                    "description": "Form Type"
                  },
                  "refid": {
                    "type": "string",
                    "description": "Reference Id for DRC01B"
                  },
                  "rtnprd": {
                    "type": "string",
                    "description": "Return Period"
                  },
                  "gstin": {
                    "type": "string",
                    "description": "GSTIN"
                  },
                  "drc03arn": {
                    "type": "array",
                    "items": {
                      "description": "Items",
                      "type": "string"
                    }
                  },
                  "reasons": {
                    "type": "array",
                    "description": "Reasons",
                    "items": {
                      "type": "object",
                      "properties": {
                        "rsn": {
                          "description": "Reason",
                          "type": "string"
                        },
                        "rsncd": {
                          "description": "Reason Code",
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "frmtyp": "DRC01B",
                "refid": "AA070922000131X",
                "rtnprd": "092022",
                "gstin": "07CMNPV1083B1ZX",
                "drc03arn": [
                  "AD070423000014X"
                ],
                "reasons": [
                  {
                    "rsn": "lbtohkhl"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reply. A failure can still come back as HTTP 200: check the error shapes in the WhiteBooks error reference."
          },
          "default": {
            "description": "A failure; the body carries the error code and message."
          }
        },
        "x-whitebooks-side-effect": "irreversible",
        "x-whitebooks-auth-flow": "gst_session"
      }
    },
