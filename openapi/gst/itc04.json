  "info": {
    "title": "WhiteBooks GST returns: ITC04",
    "version": "2026-10-13",
    "description": "Operations of the WhiteBooks GST returns API in the group ITC04, as of 2026-10-13. Start on the sandbox; every call needs your own WhiteBooks credentials and a session as the sign-in sequence describes."
  },
  "servers": [
    {
      "url": "https://apisandbox.whitebooks.in",
      "description": "Sandbox"
    },
    {
      "url": "https://api.whitebooks.in",
      "description": "Production"
    }
