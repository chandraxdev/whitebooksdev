  "info": {
    "title": "WhiteBooks GST returns: GSTR2X",
    "version": "2026-10-13",
    "description": "Operations of the WhiteBooks GST returns API in the group GSTR2X, as of 2026-10-13. Start on the sandbox; every call needs your own WhiteBooks credentials and a session as the sign-in sequence describes."
  },
  "servers": [
    {
      "url": "https://apisandbox.whitebooks.in",
      "description": "Sandbox"
    },
    {
      "url": "https://api.whitebooks.in",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "GSTR2X"
    }
  ],
  "paths": {
    "/gstr2x/tdstcs": {
      "get": {
        "operationId": "gst-gstr2x-tdstcs-get",
        "summary": "Get TDS",
        "tags": [
          "GSTR2X"
        ],
        "parameters": [
          {
            "name": "gstin",
            "in": "query",
            "required": true,
            "description": "Taxpayer GSTIN (15 characters)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "retperiod",
            "in": "query",
            "required": true,
            "description": "Return Period format MMYYYY",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "Email registered with WhiteBooks",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromtime",
            "in": "query",
            "required": true,
            "description": "From time format DD-MM-YYYY,20-12-2016",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rectype",
            "in": "query",
            "required": true,
            "description": "Rec Type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gst_username",
            "in": "header",
            "required": true,
            "description": "GST portal username",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "state_cd",
            "in": "header",
            "required": true,
            "description": "2-digit state code (first 2 characters of the GSTIN)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_address",
            "in": "header",
            "required": true,
            "description": "Caller's public IP",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "txn",
            "in": "header",
            "required": true,
            "description": "GST session transaction id from otprequest",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "client_id",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "client_secret",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          }
        ],
        "responses": {
          "200": {
            "description": "The reply. A failure can still come back as HTTP 200: check the error shapes in the WhiteBooks error reference."
          },
          "default": {
            "description": "A failure; the body carries the error code and message."
          }
        },
        "x-whitebooks-side-effect": "read",
        "x-whitebooks-auth-flow": "gst_session"
      }
    },
