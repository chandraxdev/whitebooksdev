{
  "openapi": "3.1.0",
  "info": {
    "title": "WhiteBooks e-Invoice: Cancel IRN",
    "version": "2026-10-13",
    "description": "Operations of the WhiteBooks e-Invoice API in the group Cancel IRN, as of 2026-10-13. Start on the sandbox; every call needs your own WhiteBooks credentials and a session as the sign-in sequence describes."
  },
  "servers": [
    {
      "url": "https://apisandbox.whitebooks.in",
      "description": "Sandbox"
    },
    {
      "url": "https://api.whitebooks.in",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Cancel IRN"
    }
  ],
  "paths": {
    "/einvoice/type/CANCEL/version/V1_03": {
      "post": {
        "operationId": "einvoice-einvoice-type-cancel-version-v1-03-post",
        "summary": "Cancel IRN",
        "tags": [
          "Cancel IRN"
        ],
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "Email registered with WhiteBooks",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "irp",
            "in": "query",
            "required": false,
            "description": "e-Invoice Server Type(NIC1/NIC2),given at the time of e-Invoice generation",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_address",
            "in": "header",
            "required": true,
            "description": "Caller's public IP",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "client_id",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "client_secret",
            "in": "header",
            "required": true,
            "description": "WhiteBooks app credential from the developer portal",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "username",
            "in": "header",
            "required": true,
            "description": "NIC e-Invoice / EWB API user",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "auth-token",
            "in": "header",
            "required": true,
            "description": "NIC session token from authenticate",
            "schema": {
              "type": "string",
              "writeOnly": true
            },
            "x-secret": true
          },
          {
            "name": "gstin",
            "in": "header",
            "required": true,
            "description": "Taxpayer GSTIN (15 characters)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Irn": {
                    "type": "string",
                    "description": "Irn number"
                  },
                  "CnlRsn": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Cancel Reason Number"
                  },
                  "CnlRem": {
                    "type": "string",
                    "description": "Cancel Reason"
                  }
                }
              },
              "example": {
                "Irn": "a5c12dca80e743321740b001fd70953e8738d109865d28ba4013750f2046f229",
                "CnlRsn": "1",
                "CnlRem": "Wrong entry"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reply. A failure can still come back as HTTP 200: check the error shapes in the WhiteBooks error reference."
          },
          "default": {
            "description": "A failure; the body carries the error code and message."
          }
        },
        "x-whitebooks-side-effect": "irreversible",
        "x-whitebooks-auth-flow": "einvoice_session"
      }
    }
  }
}
