  "operations": [
    {
      "id": "gst:GET:/gstr6a/b2b",
      "slug": "gst-gstr6a-b2b-get",
      "api": "gst",
      "method": "GET",
      "path": "/gstr6a/b2b",
      "tag": "GSTR6A",
      "summary": "Get B2B Invoices",
      "params": [
        {
          "name": "email",
          "in": "query",
          "required": true,
          "meaning": "Email registered with WhiteBooks"
        },
        {
          "name": "actionrequired",
          "in": "query",
          "required": false,
          "meaning": "Status filter for filtering the invoices. Action_required = Y, fetches the invoices where tax payer need to take action (Accept/Reject). Already accepted or uploaded invoices can be fetched by using action_required=N filter."
        },
        {
          "name": "gstin",
          "in": "query",
          "required": true,
          "meaning": "Taxpayer GSTIN (15 characters)"
        },
        {
          "name": "retperiod",
          "in": "query",
          "required": true,
          "meaning": "Return Period format MMYYYY"
        },
        {
          "name": "ctin",
          "in": "query",
          "required": false,
          "meaning": "CTIN of the taxpayer"
        },
        {
          "name": "fromtime",
          "in": "query",
          "required": false,
          "meaning": "From time format DD-MM-YYYY,20-12-2016"
        },
        {
          "name": "gst_username",
          "in": "header",
          "required": true,
          "meaning": "[secret] GST portal username"
        },
        {
          "name": "state_cd",
          "in": "header",
          "required": true,
          "meaning": "2-digit state code (first 2 characters of the GSTIN)"
        },
        {
          "name": "ip_address",
          "in": "header",
          "required": true,
          "meaning": "Caller's public IP"
        },
        {
          "name": "txn",
          "in": "header",
          "required": true,
          "meaning": "[secret] GST session transaction id from otprequest"
        },
        {
          "name": "client_id",
          "in": "header",
          "required": true,
          "meaning": "[secret] WhiteBooks app credential from the developer portal"
        },
        {
          "name": "client_secret",
          "in": "header",
          "required": true,
          "meaning": "[secret] WhiteBooks app credential from the developer portal"
        }
      ],
      "requestSchema": null,
      "authFlow": "gst_session",
      "sideEffect": "read",
      "related": [],
      "discrepancies": [],
      "baseUrls": {
